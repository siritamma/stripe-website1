
<!DOCTYPE html>
<html>
<head>
<title>Stripe Style Animated Website</title>

<style>

body{
margin:0;
font-family:Arial;
overflow-x:hidden;
background:linear-gradient(120deg,#635bff,#00d4ff,#ff7eb3,#7afcff);
background-size:400% 400%;
animation:bgmove 10s infinite;
}

@keyframes bgmove{
0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}
}

/* NAVBAR */

.navbar{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 70px;
color:white;
}

.menu{
display:flex;
gap:30px;
list-style:none;
}

.menu li{
cursor:pointer;
}

.signin{
background:white;
color:#635bff;
border:none;
padding:10px 20px;
border-radius:20px;
}

/* HERO */

.hero{
display:flex;
justify-content:space-between;
align-items:center;
padding:100px;
color:white;
}

.hero h1{
font-size:50px;
}

.hero p{
font-size:18px;
margin-top:15px;
}

.start{
margin-top:20px;
padding:12px 25px;
border:none;
border-radius:25px;
background:white;
color:#635bff;
font-size:16px;
cursor:pointer;
transition:0.3s;
}

.start:hover{
transform:scale(1.1);
}

/* FLOATING SHAPES */

.shape{
position:absolute;
border-radius:30px;
opacity:0.5;
animation:float 6s infinite ease-in-out;
}

.shape1{
width:120px;
height:120px;
background:white;
top:120px;
left:80px;
}

.shape2{
width:150px;
height:150px;
background:#ff7eb3;
top:350px;
right:100px;
animation-delay:2s;
}

@keyframes float{
0%{transform:translateY(0);}
50%{transform:translateY(-30px);}
100%{transform:translateY(0);}
}

/* COMPANY SLIDER */

.company-section{
background:white;
padding:40px;
overflow:hidden;
}

.company-slider{
display:flex;
gap:60px;
animation:slide 15s linear infinite;
font-weight:bold;
font-size:18px;
}

.company-slider div{
padding:10px 20px;
background:#f0f0ff;
border-radius:20px;
}

@keyframes slide{
0%{transform:translateX(0);}
100%{transform:translateX(-50%);}
}

/* FEATURES */

.features{
display:flex;
justify-content:center;
gap:40px;
padding:80px;
}

.card{
background:white;
padding:30px;
width:220px;
border-radius:12px;
box-shadow:0 10px 20px rgba(0,0,0,0.15);
text-align:center;
transition:0.3s;
}

.card:hover{
transform:translateY(-10px);
}

/* PRODUCT SECTION */

.product-section{
display:flex;
align-items:center;
justify-content:space-between;
padding:100px;
background:#f6f9fc;
}

.product-text{
width:45%;
animation:slideleft 2s ease;
}

.product-text h2{
font-size:38px;
color:#0a2540;
}

.product-text p{
font-size:18px;
color:gray;
margin-top:10px;
}

.product-image{
width:45%;
animation:slideright 2s ease;
}

.product-image img{
width:100%;
border-radius:15px;
box-shadow:0 10px 25px rgba(0,0,0,0.2);
}

@keyframes slideleft{
from{transform:translateX(-80px);opacity:0;}
to{transform:translateX(0);opacity:1;}
}

@keyframes slideright{
from{transform:translateX(80px);opacity:0;}
to{transform:translateX(0);opacity:1;}
}

/* STATS */

.stats{
display:flex;
justify-content:center;
gap:80px;
padding:80px;
background:linear-gradient(120deg,#635bff,#00d4ff);
color:white;
text-align:center;
}

.stat h2{
font-size:40px;
}

/* FEATURE GRID LIKE STRIPE */

.feature-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:30px;
padding:120px;
background:#f6f9fc;
}

.feature-card{
background:white;
border-radius:20px;
padding:30px;
position:relative;
overflow:hidden;
box-shadow:0 15px 30px rgba(0,0,0,0.1);
transition:0.4s;
}

.feature-card:hover{
transform:translateY(-10px) scale(1.02);
box-shadow:0 25px 50px rgba(0,0,0,0.2);
}

.feature-card h2{
font-size:26px;
color:#0a2540;
}

.feature-card img{
width:100%;
border-radius:15px;
margin-top:20px;
transition:0.4s;
}

.feature-card:hover img{
transform:scale(1.1);
}

/* PARTICLES */

.particles{
position:absolute;
width:200%;
height:200%;
top:-50%;
left:-50%;
background:radial-gradient(circle,#ff7eb3 2px,transparent 3px);
background-size:40px 40px;
opacity:0.2;
animation:particlesmove 12s linear infinite;
}

@keyframes particlesmove{
0%{transform:translate(0,0);}
100%{transform:translate(-100px,-100px);}
}

/* GRADIENT CARD */

.gradient-card{
background:linear-gradient(135deg,#ff7eb3,#7f7fd5,#86a8e7);
color:white;
}

.gradient-card h2{
color:white;
}

/* DARK GLOBE CARD */

.globe-bg{
background:radial-gradient(circle at center,#635bff,#0a2540);
color:white;
}

.globe-bg h2{
color:white;
}
/* FOOTER */

.footer{
background:#0a2540;
color:white;
padding:60px 80px;
}

.footer-container{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:40px;
}

.footer h3{
margin-bottom:15px;
font-size:18px;
}

.footer ul{
list-style:none;
padding:0;
}

.footer ul li{
margin:8px 0;
color:#cbd5e1;
cursor:pointer;
}

.footer ul li:hover{
color:white;
}

.footer-bottom{
text-align:center;
margin-top:40px;
border-top:1px solid rgba(255,255,255,0.2);
padding-top:20px;
font-size:14px;
color:#cbd5e1;
}

</style>
</head>

